// ══════════════════════════════════════════════════════════════
//  TRACE START INDEX TRACKERS (Prevents xloc error)
// ══════════════════════════════════════════════════════════════
var int idx_90m = bar_index
if t90_0 != t90_0[1]
    idx_90m := bar_index

var int idx_6h = bar_index
if t6h_0 != t6h_0[1]
    idx_6h := bar_index

