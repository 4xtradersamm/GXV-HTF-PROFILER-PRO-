// ══════════════════════════════════════════════════════════════
//  RONIN CORRELATION ENGINE
// ══════════════════════════════════════════════════════════════
f_get_ticker(string simple_name) => 
    if simple_name == "DXY"
        "TVC:DXY"
    else if simple_name == "US10Y"
        "TVC:US10Y"
    else
        syminfo.prefix + ":" + simple_name

f_get_ronin_correlation() =>
    string t2 = ""
    string t3 = ""
    string t4 = ""
    bool inv2 = false
    bool inv3 = false
    bool inv4 = false
    
    string check_sym = syminfo.root != "" ? syminfo.root : syminfo.ticker
    
    switch check_sym
        "XAUUSD" => 
            t2 := f_get_ticker("XAGUSD"), inv2 := false
            t3 := f_get_ticker("XAUEUR"), inv3 := false
            t4 := f_get_ticker("XAUGBP"), inv4 := false
        "XAUEUR" => 
            t2 := f_get_ticker("XAUUSD"), inv2 := false
            t3 := f_get_ticker("XAUGBP"), inv3 := false
        "XAUGBP" => 
            t2 := f_get_ticker("XAUUSD"), inv2 := false
            t3 := f_get_ticker("XAUEUR"), inv3 := false
        "XAGUSD" => 
            t2 := f_get_ticker("XAUUSD"), inv2 := false
            t3 := f_get_ticker("XAUEUR"), inv3 := false
        "RB" => 
            t2 := "HO1!", inv2 := false
            t3 := "CL1!", inv3 := false
        "HO" => 
            t2 := "RB1!", inv2 := false
            t3 := "CL1!", inv3 := false
        "CL" => 
            t2 := "HO1!", inv2 := false
            t3 := "RB1!", inv3 := false
        "MNQ" => 
            t2 := "MES1!", inv2 := false
            t3 := "MYM1!", inv3 := false
        "MES" => 
            t2 := "MNQ1!", inv2 := false
            t3 := "MYM1!", inv3 := false
        "MYM" => 
            t2 := "MES1!", inv2 := false
            t3 := "MNQ1!", inv3 := false
        "NQ" => 
            t2 := "ES1!", inv2 := false
            t3 := "YM1!", inv3 := false
        "ES" => 
            t2 := "NQ1!", inv2 := false
            t3 := "YM1!", inv3 := false
        "YM" => 
            t2 := "ES1!", inv2 := false
            t3 := "NQ1!", inv3 := false
        "GC" =>
            t2 := "SI1!", inv2 := false
            t3 := "NQ1!", inv3 := false
        "NASDAQ" => 
            t2 := "PEPPERSTONE:US500", inv2 := false
            t3 := "PEPPERSTONE:US30",  inv3 := false
        "NDAQ100" => 
            t2 := "PEPPERSTONE:US500", inv2 := false
            t3 := "PEPPERSTONE:US30",  inv3 := false
        "NAS100" => 
            t2 := "PEPPERSTONE:US500", inv2 := false
            t3 := "PEPPERSTONE:US30",  inv3 := false
        "SPX500" => 
            t2 := "PEPPERSTONE:NAS100", inv2 := false
            t3 := "PEPPERSTONE:US30",   inv3 := false
        "US500" => 
            t2 := "PEPPERSTONE:NAS100", inv2 := false
            t3 := "PEPPERSTONE:US30",   inv3 := false
        "US30" => 
            t2 := "PEPPERSTONE:NAS100", inv2 := false
            t3 := "PEPPERSTONE:US500",  inv3 := false
        "DJI" => 
            t2 := "PEPPERSTONE:NAS100", inv2 := false
            t3 := "PEPPERSTONE:US500",  inv3 := false
        "WALLSTREET" => 
            t2 := "PEPPERSTONE:NAS100", inv2 := false
            t3 := "PEPPERSTONE:US500",  inv3 := false
        "EURUSD" => 
            t2 := f_get_ticker("GBPUSD"), inv2 := false
            t3 := "TVC:DXY",              inv3 := true 
        "GBPUSD" => 
            t2 := f_get_ticker("EURUSD"), inv2 := false
            t3 := "TVC:DXY",              inv3 := true 
        "AUDUSD" => 
            t2 := f_get_ticker("NZDUSD"), inv2 := false
            t3 := "TVC:DXY",              inv3 := true
        "NZDUSD" => 
            t2 := f_get_ticker("AUDUSD"), inv2 := false
            t3 := "TVC:DXY",              inv3 := true
        "USDJPY" => 
            t2 := "TVC:DXY",              inv2 := false
        "USDCAD" => 
            t2 := "TVC:DXY",              inv2 := false
        "USDCHF" => 
            t2 := "TVC:DXY",              inv2 := false
        "EURJPY" => 
            t2 := f_get_ticker("GBPJPY"), inv2 := false
        "GBPJPY" => 
            t2 := f_get_ticker("EURJPY"), inv2 := false
        "AUDJPY" => 
            t2 := f_get_ticker("NZDJPY"), inv2 := false
        "NZDJPY" => 
            t2 := f_get_ticker("AUDJPY"), inv2 := false
        "EURAUD" => 
            t2 := f_get_ticker("GBPAUD"), inv2 := false
        "GBPAUD" => 
            t2 := f_get_ticker("EURAUD"), inv2 := false
        "EURNZD" => 
            t2 := f_get_ticker("GBPNZD"), inv2 := false
        "GBPNZD" => 
            t2 := f_get_ticker("EURNZD"), inv2 := false
        "EURCAD" => 
            t2 := f_get_ticker("GBPCAD"), inv2 := false
        "GBPCAD" => 
            t2 := f_get_ticker("EURCAD"), inv2 := false
        "AUDCAD" => 
            t2 := f_get_ticker("NZDCAD"), inv2 := false
        "NZDCAD" => 
            t2 := f_get_ticker("AUDCAD"), inv2 := false
        "BTCUSDT" =>
            t2 := f_get_ticker("ETHUSDT"), inv2 := false
        "ETHUSDT" =>
            t2 := f_get_ticker("BTCUSDT"), inv2 := false
            
    [t2, t3, t4, inv2, inv3, inv4]

var string ticker1 = syminfo.tickerid 
var string ticker2 = ""
var string ticker3 = ""
var string ticker4 = ""
var bool   inv2    = false
var bool   inv3    = false
var bool   inv4    = false

if barstate.isfirst
    if i_psp_mode == "Auto (Ronin)"
        [t2, t3, t4, i2, i3, i4] = f_get_ronin_correlation()
        ticker2 := t2
        ticker3 := t3
        ticker4 := t4
        inv2 := i2
        inv3 := i3
        inv4 := i4
    else
        ticker2 := i_psp_t2
        ticker3 := i_psp_t3
        inv3    := i_psp_inv3

// ══════════════════════════════════════════════════════════════
//  AUTO-DETECT LOGIC (BROKER AGNOSTIC)
// ══════════════════════════════════════════════════════════════
int current_d_time = time("D")
int auto_hr  = not na(current_d_time) ? hour(current_d_time, "America/New_York") : 17
int auto_min = not na(current_d_time) ? minute(current_d_time, "America/New_York") : 0

int eff_hr  = i_sess_mode == "Auto" ? auto_hr : i_daily_hr
int eff_min = i_sess_mode == "Auto" ? auto_min : i_daily_min

// ══════════════════════════════════════════════════════════════
//  DYNAMIC LOWER TIMEFRAME ARRAY AGGREGATOR
// ══════════════════════════════════════════════════════════════
string auto_base_tf = timeframe.in_seconds() < 900 ? timeframe.period : "15"

// Base Ticker Arrays
var array<float> g_o15 = array.new<float>()
var array<float> g_h15 = array.new<float>()
var array<float> g_l15 = array.new<float>()
var array<float> g_c15 = array.new<float>()
var array<int>   g_t15 = array.new<int>()

// Correlated Ticker Arrays (Only O/C needed for PSP)
var array<float> g_o2 = array.new<float>()
var array<float> g_c2 = array.new<float>()
var array<int>   g_t2 = array.new<int>()

var array<float> g_o3 = array.new<float>()
var array<float> g_c3 = array.new<float>()
var array<int>   g_t3 = array.new<int>()

var array<float> g_o4 = array.new<float>()
var array<float> g_c4 = array.new<float>()
var array<int>   g_t4 = array.new<int>()

[o15, h15, l15, c15, t15] = request.security_lower_tf(syminfo.tickerid, auto_base_tf, [open, high, low, close, time])
[o15_2, c15_2, t15_2]     = request.security_lower_tf(ticker2 != "" ? ticker2 : syminfo.tickerid, auto_base_tf, [open, close, time], ignore_invalid_symbol=true)
[o15_3, c15_3, t15_3]     = request.security_lower_tf(ticker3 != "" ? ticker3 : syminfo.tickerid, auto_base_tf, [open, close, time], ignore_invalid_symbol=true)
[o15_4, c15_4, t15_4]     = request.security_lower_tf(ticker4 != "" ? ticker4 : syminfo.tickerid, auto_base_tf, [open, close, time], ignore_invalid_symbol=true)

f_push_arrays(arr_src, arr_dst) =>
    if array.size(arr_src) > 0
        for i = 0 to array.size(arr_src) - 1
            array.push(arr_dst, array.get(arr_src, i))

f_push_arrays(o15, g_o15), f_push_arrays(h15, g_h15), f_push_arrays(l15, g_l15), f_push_arrays(c15, g_c15), f_push_arrays(t15, g_t15)
if ticker2 != ""
    f_push_arrays(o15_2, g_o2), f_push_arrays(c15_2, g_c2), f_push_arrays(t15_2, g_t2)
if ticker3 != ""
    f_push_arrays(o15_3, g_o3), f_push_arrays(c15_3, g_c3), f_push_arrays(t15_3, g_t3)
if ticker4 != ""
    f_push_arrays(o15_4, g_o4), f_push_arrays(c15_4, g_c4), f_push_arrays(t15_4, g_t4)

f_clip_arrays(arr) =>
    int max_bars = 5000 
    if array.size(arr) > max_bars
        int excess = array.size(arr) - max_bars
        for i = 1 to excess
            array.shift(arr)

f_clip_arrays(g_o15), f_clip_arrays(g_h15), f_clip_arrays(g_l15), f_clip_arrays(g_c15), f_clip_arrays(g_t15)
f_clip_arrays(g_o2), f_clip_arrays(g_c2), f_clip_arrays(g_t2)
f_clip_arrays(g_o3), f_clip_arrays(g_c3), f_clip_arrays(g_t3)
f_clip_arrays(g_o4), f_clip_arrays(g_c4), f_clip_arrays(g_t4)

f_get_custom_htf(int target_mins, array<int> arr_t, array<float> arr_o, array<float> arr_h, array<float> arr_l, array<float> arr_c) =>
    array<float> out_o = array.new<float>()
    array<float> out_h = array.new<float>()
    array<float> out_l = array.new<float>()
    array<float> out_c = array.new<float>()
    array<int>   out_t = array.new<int>()
    
    int sz = array.size(arr_t)
    if sz > 0
        int last_htf_open = -1
        float cur_o = na, float cur_h = na, float cur_l = na, float cur_c = na
        int cur_t = na
        
        for i = sz - 1 to 0
            int t = array.get(arr_t, i)
            int h_ny = hour(t, "America/New_York")
            int m_ny = minute(t, "America/New_York")
            
            int elapsed_mins_today = h_ny * 60 + m_ny
            int anchor_mins_today = eff_hr * 60 + eff_min
            
            int shift_mins = elapsed_mins_today - anchor_mins_today
            if shift_mins < 0
                shift_mins += 1440
                
            int htf_open_time = t - ((shift_mins % target_mins) * 60000)
            
            if htf_open_time != last_htf_open
                if last_htf_open != -1
                    array.push(out_o, cur_o), array.push(out_h, cur_h), array.push(out_l, cur_l), array.push(out_c, cur_c), array.push(out_t, cur_t)
                    if array.size(out_o) >= 5
                        break
                        
                last_htf_open := htf_open_time
                cur_c := array.get(arr_c, i), cur_h := array.get(arr_h, i), cur_l := array.get(arr_l, i), cur_o := array.get(arr_o, i), cur_t := htf_open_time
            else
                cur_h := math.max(cur_h, array.get(arr_h, i)), cur_l := math.min(cur_l, array.get(arr_l, i)), cur_o := array.get(arr_o, i)
                
        if array.size(out_o) < 5 and last_htf_open != -1
            array.push(out_o, cur_o), array.push(out_h, cur_h), array.push(out_l, cur_l), array.push(out_c, cur_c), array.push(out_t, cur_t)
            
    while array.size(out_o) < 5
        array.push(out_o, na), array.push(out_h, na), array.push(out_l, na), array.push(out_c, na), array.push(out_t, na)
        
    [out_o, out_h, out_l, out_c, out_t]

f_get_custom_htf_oc(int target_mins, array<int> arr_t, array<float> arr_o, array<float> arr_c) =>
    array<float> out_o = array.new<float>()
    array<float> out_c = array.new<float>()
    
    int sz = array.size(arr_t)
    if sz > 0
        int last_htf_open = -1
        float cur_o = na, float cur_c = na
        for i = sz - 1 to 0
            int t = array.get(arr_t, i)
            int h_ny = hour(t, "America/New_York"), m_ny = minute(t, "America/New_York")
            int shift_mins = (h_ny * 60 + m_ny) - (eff_hr * 60 + eff_min)
            if shift_mins < 0
                shift_mins += 1440
            int htf_open_time = t - ((shift_mins % target_mins) * 60000)

            if htf_open_time != last_htf_open
                if last_htf_open != -1
                    array.push(out_o, cur_o), array.push(out_c, cur_c)
                    if array.size(out_o) >= 5
                        break
                last_htf_open := htf_open_time
                cur_c := array.get(arr_c, i), cur_o := array.get(arr_o, i)
            else
                cur_o := array.get(arr_o, i)
                
        if array.size(out_o) < 5 and last_htf_open != -1
            array.push(out_o, cur_o), array.push(out_c, cur_c)
            
    while array.size(out_o) < 5
        array.push(out_o, na), array.push(out_c, na)
    [out_o, out_c]

// ══════════════════════════════════════════════════════════════
//  PSP CALCULATION ENGINE
// ══════════════════════════════════════════════════════════════
f_calc_psp(array<float> os, array<float> hs, array<float> ls, array<float> cs, array<float> o2, array<float> c2, array<float> o3, array<float> c3, array<float> o4, array<float> c4) =>
    array<int> psp = array.new<int>(5, 0)
    int left = i_psp_left
    int right = i_psp_right

    for i = right to (4 - left)
        if na(os.get(i))
            continue

        bool is_ph = true
        for j = 1 to left
            if hs.get(i) <= hs.get(i + j)
                is_ph := false
        for j = 1 to right
            if hs.get(i) <= hs.get(i - j)
                is_ph := false

        bool is_pl = true
        for j = 1 to left
            if ls.get(i) >= ls.get(i + j)
                is_pl := false
        for j = 1 to right
            if ls.get(i) >= ls.get(i - j)
                is_pl := false

        if is_ph or is_pl
            bool b1 = cs.get(i) >= os.get(i)
            bool crack = false

            if ticker2 != "" and array.size(o2) > i and not na(o2.get(i))
                bool b2 = (c2.get(i) >= o2.get(i))
                if inv2
                    b2 := not b2
                if b1 != b2
                    crack := true

            if ticker3 != "" and array.size(o3) > i and not na(o3.get(i))
                bool b3 = (c3.get(i) >= o3.get(i))
                if inv3
                    b3 := not b3
                if b1 != b3
                    crack := true

            if ticker4 != "" and array.size(o4) > i and not na(o4.get(i))
                bool b4 = (c4.get(i) >= o4.get(i))
                if inv4
                    b4 := not b4
                if b1 != b4
                    crack := true

            if crack
                if is_ph
                    psp.set(i, 1) // 1 = psp bear color
                if is_pl
                    psp.set(i, 2) // 2 = psp bull color
    psp

// ══════════════════════════════════════════════════════════════
//  MAP VARIABLES TO DRAW LOGIC
// ══════════════════════════════════════════════════════════════
[o90_arr, h90_arr, l90_arr, c90_arr, t90_arr] = f_get_custom_htf(90, g_t15, g_o15, g_h15, g_l15, g_c15)
