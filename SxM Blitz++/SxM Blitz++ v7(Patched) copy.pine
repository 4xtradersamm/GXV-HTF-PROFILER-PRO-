// ══════════════════════════════════════════════════════════════
//  DRAWING STORAGE & TRACES
// ══════════════════════════════════════════════════════════════
var array<box>   g_bodies    = array.new<box>()
var array<line>  g_wicks_up  = array.new<line>()
var array<line>  g_wicks_dn  = array.new<line>()
var array<box>   g_fvgs      = array.new<box>()
var array<line>  g_sweeps    = array.new<line>()
var array<line>  g_mids      = array.new<line>()
var array<label> g_timelabels = array.new<label>()
var array<line>  g_traces    = array.new<line>()

var label g_lbl_90m = na
var label g_lbl_6h  = na
var label g_lbl_1d  = na

// ══════════════════════════════════════════════════════════════
//  HELPERS
// ══════════════════════════════════════════════════════════════
isValidHTF(int target_mins) =>
    timeframe.in_seconds() <= target_mins * 60

calcMidpoint(float h, float l, float o, float c) =>
    float lh = math.log(h)
    float ll = math.log(l)
    float lo = math.log(o)
    float lc = math.log(c)
    float uw = lh - math.max(lo, lc)
    float lw = math.min(lo, lc) - ll
    float bs = math.abs(lc - lo)
    float lmid = math.max(uw, lw) > bs ? (uw > lw ? lh - uw / 2 : ll + lw / 2) : (lh + ll) / 2
    math.exp(lmid)

formatTime(int t) =>
    str.format_time(t, "HH:mm", "America/New_York")

remainingCustomTime(int openTime, int target_mins) =>
    if barstate.isrealtime and not na(openTime)
        int closeTime = openTime + (target_mins * 60000)
        int rem = math.max(0, int((closeTime - timenow) / 1000))
        if rem == 0
            '00:00'
        else
            int d = int(rem / 86400)
            int h = int((rem - d * 86400) / 3600)
            int m = int((rem - d * 86400 - h * 3600) / 60)
            int s = int(rem - d * 86400 - h * 3600 - m * 60)
            string r = str.tostring(s, '00')
            if m > 0 or h > 0 or d > 0
                r := str.tostring(m, '00') + ':' + r
            if h > 0 or d > 0
                r := str.tostring(h, '00') + ':' + r
            if d > 0
                r := str.tostring(d) + 'D ' + r
            r
    else
        'n/a'

get_line_style2(string s) =>
    s == "----" ? line.style_dashed : s == "····" ? line.style_dotted : line.style_solid

f_draw_traces(int start_idx, float o, float h, float l, float c, int newest_x1, int newest_xm, string tf_name) =>
    if i_trace_tf == "All" or i_trace_tf == tf_name
        if i_trace_o
            g_traces.push(line.new(start_idx, o, newest_x1, o, color=i_trace_o_col, style=get_line_style2(i_trace_o_sty)))
        if i_trace_c
            g_traces.push(line.new(start_idx, c, newest_x1, c, color=i_trace_c_col, style=get_line_style2(i_trace_c_sty)))
        if i_trace_h
            g_traces.push(line.new(start_idx, h, newest_xm, h, color=i_trace_h_col, style=get_line_style2(i_trace_h_sty)))
        if i_trace_l
            g_traces.push(line.new(start_idx, l, newest_xm, l, color=i_trace_l_col, style=get_line_style2(i_trace_l_sty)))

// ══════════════════════════════════════════════════════════════
//  DELETE ALL
// ══════════════════════════════════════════════════════════════
deleteAll() =>
    int i = 0
    while i < g_bodies.size()
        box.delete(g_bodies.get(i)), i += 1
    g_bodies.clear(), i := 0
    while i < g_wicks_up.size()
        line.delete(g_wicks_up.get(i)), i += 1
    g_wicks_up.clear(), i := 0
    while i < g_wicks_dn.size()
        line.delete(g_wicks_dn.get(i)), i += 1
    g_wicks_dn.clear(), i := 0
    while i < g_fvgs.size()
        box.delete(g_fvgs.get(i)), i += 1
    g_fvgs.clear(), i := 0
    while i < g_sweeps.size()
        line.delete(g_sweeps.get(i)), i += 1
    g_sweeps.clear(), i := 0
    while i < g_mids.size()
        line.delete(g_mids.get(i)), i += 1
    g_mids.clear(), i := 0
    while i < g_timelabels.size()
        label.delete(g_timelabels.get(i)), i += 1
    g_timelabels.clear()
    while g_traces.size() > 0
        line.delete(g_traces.pop())

// ══════════════════════════════════════════════════════════════
//  DRAW CANDLE
// ══════════════════════════════════════════════════════════════
drawCandle(float o, float h, float l, float c, int t, int slot, int startOff, TFColors col, int psp_status) =>
    int x1 = bar_index + startOff + slot * (i_width + i_buffer)
    int x2 = x1 + i_width
    int xm = x1 + i_width / 2
    bool bull = c >= o
    
    color b_col = bull ? col.bull_body : col.bear_body
    if psp_status == 1
        b_col := i_psp_bear_col
    else if psp_status == 2
        b_col := i_psp_bull_col
        
    box bd = box.new(x1, math.max(o,c), x2, math.min(o,c),
             bull ? col.bull_border : col.bear_border, 1,
             bgcolor = b_col)
    line wu = line.new(xm, h, xm, math.max(o,c), color = bull ? col.bull_wick : col.bear_wick)
    line wd = line.new(xm, math.min(o,c), xm, l,  color = bull ? col.bull_wick : col.bear_wick)
    g_bodies.push(bd)
    g_wicks_up.push(wu)
    g_wicks_dn.push(wd)
    
    if i_show_time and not na(t)
        label tl = label.new(xm, l, formatTime(t),
                     color=transparent, textcolor=i_time_color,
                     style=label.style_label_up, size=size.normal,
                     text_font_family=font.family_monospace)
        g_timelabels.push(tl)
    [x1, x2, h, l]

// ══════════════════════════════════════════════════════════════
//  DRAW BLOCK
// ══════════════════════════════════════════════════════════════
drawBlock(
     float o0, float h0, float l0, float c0, int t0,
     float o1, float h1, float l1, float c1, int t1,
     float o2, float h2, float l2, float c2, int t2,
     float o3, float h3, float l3, float c3, int t3,
     float o4, float h4, float l4, float c4, int t4,
     array<int> psp_arr, int startOff, int n, TFColors col) =>

    os = array.from(o4, o3, o2, o1, o0)
    hs = array.from(h4, h3, h2, h1, h0)
    ls = array.from(l4, l3, l2, l1, l0)
    cs = array.from(c4, c3, c2, c1, c0)
    ts = array.from(t4, t3, t2, t1, t0)

    int si = 5 - n

    xs1  = array.new<int>()
    xs2  = array.new<int>()
    chs  = array.new<float>()
    cls  = array.new<float>()
    cos  = array.new<float>()
    ccs  = array.new<float>()
    float blockHigh = 0.0

    int slot = 0
    while slot < n
        int idx = si + slot
        float co = os.get(idx)
        float ch = hs.get(idx)
        float cl = ls.get(idx)
        float cc = cs.get(idx)
        int   ct = ts.get(idx)
        
        int p_idx = 4 - idx // Match array indexing for PSP
        int psp_status = psp_arr.get(p_idx)
        
        if not na(co)
            [x1, x2, cvh, cvl] = drawCandle(co, ch, cl, cc, ct, slot, startOff, col, psp_status)
            xs1.push(x1)
            xs2.push(x2)
            chs.push(ch)
            cls.push(cl)
            cos.push(co)
            ccs.push(cc)
            if ch > blockHigh
                blockHigh := ch
        slot += 1

    int drawn = xs1.size()

    if i_mid_show and drawn >= 2
        int i = 0
        while i < drawn - 1
            float mid = calcMidpoint(chs.get(i), cls.get(i), cos.get(i), ccs.get(i))
            int mx1 = xs1.get(i)   + i_width / 2
            int mx2 = xs1.get(i+1) + i_width / 2
            g_mids.push(line.new(mx1, mid, mx2, mid, color=i_mid_color, style=line.style_dotted, width=1))
            i += 1

    if i_sweep_show and drawn >= 2
        int i = 0
        while i < drawn - 1
            float ph = chs.get(i)
            float pl = cls.get(i)
            float nh = chs.get(i+1)
            float nl = cls.get(i+1)
            float nc = ccs.get(i+1)
            int sx1 = xs1.get(i)   + i_width / 2
            int sx2 = xs2.get(i+1)
            if nh > ph and nc < ph
                g_sweeps.push(line.new(sx1, ph, sx2, ph, color=i_sweep_color, width=1))
            if nl < pl and nc > pl
                g_sweeps.push(line.new(sx1, pl, sx2, pl, color=i_sweep_color, width=1))
            i += 1

    if i_fvg_show and drawn >= 3
        int i = 0
        while i < drawn - 2
            float h1f = chs.get(i)
            float l1f = cls.get(i)
            float h3f = chs.get(i+2)
            float l3f = cls.get(i+2)
            int fx1 = xs1.get(i)
            int fx2 = xs2.get(i+2)
            if l1f > h3f
                g_fvgs.push(box.new(fx1, l1f, fx2, h3f, bgcolor=i_fvg_color, border_color=transparent))
            if h1f < l3f
                g_fvgs.push(box.new(fx1, l3f, fx2, h1f, bgcolor=i_fvg_color, border_color=transparent))
            i += 1

    int totalW  = n * i_width + math.max(0, n-1) * i_buffer
    int centerX = bar_index + startOff + totalW / 2
    [centerX, blockHigh, startOff + totalW + i_htfgap]

// ══════════════════════════════════════════════════════════════
//  COLOR OBJECTS
// ══════════════════════════════════════════════════════════════
TFColors col_90m = TFColors.new(i_90m_bull_body,i_90m_bear_body,i_90m_bull_border,i_90m_bear_border,i_90m_bull_wick,i_90m_bear_wick)
TFColors col_6h  = TFColors.new(i_6h_bull_body, i_6h_bear_body, i_6h_bull_border, i_6h_bear_border, i_6h_bull_wick, i_6h_bear_wick)
TFColors col_1d  = TFColors.new(i_1d_bull_body, i_1d_bear_body, i_1d_bull_border, i_1d_bear_border, i_1d_bull_wick, i_1d_bear_wick)

// ══════════════════════════════════════════════════════════════
//  MAIN
// ══════════════════════════════════════════════════════════════
if barstate.islast
    deleteAll()
    int n   = math.min(i_maxshow, 5)
    int off = i_offset

    if i_show_90m and isValidHTF(90)
        [cx, top, nextOff] = drawBlock(
             o90_0,h90_0,l90_0,c90_0,t90_0,
             o90_1,h90_1,l90_1,c90_1,t90_1,
             o90_2,h90_2,l90_2,c90_2,t90_2,
             o90_3,h90_3,l90_3,c90_3,t90_3,
             o90_4,h90_4,l90_4,c90_4,t90_4,
             psp_90, off, n, col_90m)
        
        int newest_x1_90m = bar_index + off + (n - 1) * (i_width + i_buffer)
        f_draw_traces(idx_90m, o90_0, h90_0, l90_0, c90_0, newest_x1_90m, newest_x1_90m + i_width / 2, "90M")

        if i_show_label
            string txt = 'TF: 90M' + (i_show_timer ? '\n[' + remainingCustomTime(t90_0, 90) + ']' : '')
            if na(g_lbl_90m)
                g_lbl_90m := label.new(cx, top, txt, color=transparent, textcolor=i_label_color, style=label.style_label_down, size=i_label_size, text_font_family=font.family_monospace)
            else
                label.set_xy(g_lbl_90m, cx, top)
                label.set_text(g_lbl_90m, txt)
        off := nextOff

    if i_show_6h and isValidHTF(360)
        [cx, top, nextOff] = drawBlock(
             o6h_0,h6h_0,l6h_0,c6h_0,t6h_0,
             o6h_1,h6h_1,l6h_1,c6h_1,t6h_1,
             o6h_2,h6h_2,l6h_2,c6h_2,t6h_2,
             o6h_3,h6h_3,l6h_3,c6h_3,t6h_3,
             o6h_4,h6h_4,l6h_4,c6h_4,t6h_4,
             psp_6h, off, n, col_6h)
             
        int newest_x1_6h = bar_index + off + (n - 1) * (i_width + i_buffer)
        f_draw_traces(idx_6h, o6h_0, h6h_0, l6h_0, c6h_0, newest_x1_6h, newest_x1_6h + i_width / 2, "6H")

        if i_show_label
            string txt = 'TF: 6H' + (i_show_timer ? '\n[' + remainingCustomTime(t6h_0, 360) + ']' : '')
            if na(g_lbl_6h)
                g_lbl_6h := label.new(cx, top, txt, color=transparent, textcolor=i_label_color, style=label.style_label_down, size=i_label_size, text_font_family=font.family_monospace)
            else
                label.set_xy(g_lbl_6h, cx, top)
                label.set_text(g_lbl_6h, txt)
        off := nextOff

    if i_show_1d and isValidHTF(1440)
        [cx, top, nextOff] = drawBlock(
             o1d_0,h1d_0,l1d_0,c1d_0,t1d_0,
             o1d_1,h1d_1,l1d_1,c1d_1,t1d_1,
             o1d_2,h1d_2,l1d_2,c1d_2,t1d_2,
             o1d_3,h1d_3,l1d_3,c1d_3,t1d_3,
             o1d_4,h1d_4,l1d_4,c1d_4,t1d_4,
             psp_1d, off, n, col_1d)
             
        int newest_x1_1d = bar_index + off + (n - 1) * (i_width + i_buffer)
        f_draw_traces(idx_1d, o1d_0, h1d_0, l1d_0, c1d_0, newest_x1_1d, newest_x1_1d + i_width / 2, "1d")

        if i_show_label
            string txt = 'TF: 1d' + (i_show_timer ? '\n[' + remainingCustomTime(t1d_0, 1440) + ']' : '')
            if na(g_lbl_1d)
                g_lbl_1d := label.new(cx, top, txt, color=transparent, textcolor=i_label_color, style=label.style_label_down, size=i_label_size, text_font_family=font.family_monospace)
            else
                label.set_xy(g_lbl_1d, cx, top)
                label.set_text(g_lbl_1d, txt)