//@version=6
indicator("SxM Blitz++v7 (Patched) copy", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=5000)
import GXVSanctuary/AssetCorrelationUtils/5 as GXV

// =============================================================================
// SxM Blitz++ — PATCHED BUILD
// -----------------------------------------------------------------------------
// Timezone            : UTC-offset input (manual DST switch), single owner
// Core time/hierarchy : one comparative fractal engine (fixes dual-engine bug)
// Dividers            : exactly 2 sources (primary + parent) — no extras
// Dealing Range/TrueOpen: fixed session/day-of-week/week/month anchors per your spec
// Trend Engine        : MACD + Premium/Discount + True Open, majority vote
// SSMT                : v1-style line-between-pivots, session-tagged, pair filter
// tCISD               : arms from SSMT OR Turtle Soup, anchors at REFERENCE candle,
//                       fixed 3-bar extension, gated + cancelled by Trend Engine
// Turtle Soup / HTF SSMT / Auto Symbols / Alerts : carried over unchanged
// Dashboard           : fractal Time + True-Open row (v3) PLUS QT cycle/quarter
//                       label row (v2-style), on the same table
// =============================================================================


// =============================================================================
// 1. TIMEZONE — MANUAL UTC OFFSET (single owner, DST-safe by design)
// =============================================================================
//
// Rather than an IANA zone name (which is what produced the Azores-default /
// session-mislabeling bugs in earlier builds), this uses a plain UTC-offset
// number that you flip by hand between DST states:
//   -5.0  = Eastern Standard Time  (early Nov – early Mar)
//   -4.0  = Eastern Daylight Time  (mid Mar – early Nov)
// The offset is pure arithmetic on the UTC epoch, so every downstream
// calendar read (day/week/month/quarter/year) rolls over correctly with no
// special-casing required.
// =============================================================================

string G_TZ = "Timezone"

float utcOffsetHours = input.float(
     -4.0,
     "EST/EDT UTC Offset (hours) — set -4 in Daylight Time, -5 in Standard Time",
     minval=-12,
     maxval=14,
     step=0.5,
     group=G_TZ)

int offsetMs = int(utcOffsetHours * 3600000)
int estTime  = time + offsetMs

int eY   = year(estTime, "UTC")
int eM   = month(estTime, "UTC")
int eD   = dayofmonth(estTime, "UTC")
int eH   = hour(estTime, "UTC")
int eMin = minute(estTime, "UTC")
int eDow = dayofweek(estTime, "UTC")

// ---- Shared "trading day" clock: shifted 6h so 18:00 EST -> next day 00:00.
//      Used everywhere a "Day" concept (newDay/newWeek, day labels, dividers,
//      Dealing Range, True Opens) needs the real futures/forex daily open
//      instead of midnight. eM/eY (month/quarter/year boundaries) stay on the
//      plain calendar clock below — those don't shift with the daily session.
int tradingTime = estTime + 21600000   // shift 6h: 18:00 EST -> next day 00:00
int tD   = dayofmonth(tradingTime, "UTC")
int tDow = dayofweek(tradingTime, "UTC")


// =============================================================================
// 2. CORE CALENDAR + SESSION + 90-MINUTE ENGINE (single source of truth)
// =============================================================================

int totalMin   = eH * 60 + eMin
int shiftedMin = (totalMin - 1080 + 1440) % 1440     // 1080 = 18:00, the Asia open
int sessIdx0   = int(shiftedMin / 360)
int sessionNum = sessIdx0 + 1
int subQIdx0   = int((shiftedMin % 360) / 90)
int subQNum    = subQIdx0 + 1

string sessAbbrev = sessIdx0 == 0 ? "ASIA" : sessIdx0 == 1 ? "UK" : sessIdx0 == 2 ? "NYAM" : "NYPM"

string dayName3 =
     tDow == dayofweek.sunday    ? "SUN" :
     tDow == dayofweek.monday    ? "MON" :
     tDow == dayofweek.tuesday   ? "TUE" :
     tDow == dayofweek.wednesday ? "WED" :
     tDow == dayofweek.thursday  ? "THU" :
     tDow == dayofweek.friday    ? "FRI" : "SAT"

// ---- Boundary flags (comparative only — never timeframe.change(), never a
//      precomputed future timestamp) ----
bool newSubQ    = na(subQNum[1])   or subQNum   != subQNum[1]
bool newSession = na(sessionNum[1]) or sessionNum != sessionNum[1]
bool newDay     = na(tD[1]) or tD != tD[1]
bool newWeek    = newDay and tDow == dayofweek.monday
// FIX: was `newDay and eD == 1` — an exact match on calendar day-of-month.
// On a 1D chart with a weekend/holiday gap, or on a 1W+ chart (bars almost
// never land exactly on day 1), no bar ever satisfies eD==1, so newMonth
// (and everything gated by it — weekOfMonth's reset, monthOfQuarter,
// quarterOfYear, Dealing Range, dividers, True Opens) could silently never
// fire, freezing weekOfMonth at whatever it last reached. Detecting "the
// month NUMBER differs from the previous bar" instead is robust to gaps —
// the same bar-to-bar-difference approach already used for newDay/newWeek.
bool newMonth   = na(eM[1]) or eM != eM[1]
bool newQuarter = newMonth and (eM == 1 or eM == 4 or eM == 7 or eM == 10)
bool newYear    = newMonth and eM == 1

// ---- Counters ----
// weekOfMonth stays stateful (Monday-counting) — it can't be made fully
// stateless without a first-day-of-month weekday calculation. A 5th real
// Monday in a month folds into Week4 (same convention already used for
// Friday+weekend folding into Thursday's Q4).
var int weekOfMonth = 1

if newMonth
    weekOfMonth := 1
else if newWeek
    weekOfMonth := math.min(weekOfMonth + 1, 4)

// monthOfQuarter/quarterOfYear are pure calendar math, recomputed every bar
// — stateless, so they can't drift if a newMonth/newQuarter flag is ever
// missed (holiday gap, feed gap, etc.).
int monthOfQuarter = ((eM - 1) % 3) + 1
int quarterOfYear  = ((eM - 1) / 3) + 1


// =============================================================================
// 3. TIMEFRAME HIERARCHY RESOLVER — ONE resolver, feeds dividers + labels only
//    (Dealing Range and True-Open use their own fixed anchors — Section 5/7)
// =============================================================================

float chartSeconds = timeframe.in_seconds(timeframe.period)

bool   primaryNew       = false
bool   parentNew        = false
string primaryLabelText = ""
string cycleName        = ""

if chartSeconds <= 300                                     // ≤5m
    primaryNew       := newSubQ
    parentNew        := newSession
    primaryLabelText := "Q" + str.tostring(subQNum)
    cycleName        := "90 Minute"
else if chartSeconds <= 900                                // ≤15m
    primaryNew       := newSession
    parentNew        := newDay
    primaryLabelText := sessAbbrev
    cycleName        := "6 Hour (Session)"
else if chartSeconds <= 3600                                // ≤1H
    primaryNew       := newDay
    parentNew        := newWeek
    primaryLabelText := dayName3
    cycleName        := "Daily"
else if chartSeconds <= 14400                                // ≤4H
    primaryNew       := newWeek
    parentNew        := newMonth
    primaryLabelText := "W" + str.tostring(weekOfMonth)
    cycleName        := "Weekly"
else if chartSeconds <= 86400                                // ≤1D
    primaryNew       := newMonth
    parentNew        := newQuarter
    primaryLabelText := "M" + str.tostring(monthOfQuarter)
    cycleName        := "Monthly"
else                                                          // ≥1W
    primaryNew       := newQuarter
    parentNew        := newYear
    primaryLabelText := "QT" + str.tostring(quarterOfYear)
    cycleName        := "Yearly"

// v2-style cosmetic "Q1..Q4" number for the dashboard's QT row — reuses
// whichever counter is meaningful at the active bracket.
int qtQuarterNum =
     chartSeconds <= 300    ? subQNum :
     chartSeconds <= 900    ? sessionNum :
     chartSeconds <= 3600   ? (tDow == dayofweek.monday ? 1 : tDow == dayofweek.tuesday ? 2 : tDow == dayofweek.wednesday ? 3 : 4) :
     chartSeconds <= 14400  ? math.min(weekOfMonth, 4) :
     chartSeconds <= 86400  ? monthOfQuarter :
     quarterOfYear


// =============================================================================
// 4. DIVIDERS — exactly two trigger sources, nothing else draws a divider
// =============================================================================

string G_DIV = "Dividers"

bool showPrimaryDivider = input.bool(true,  "Show Primary Divider", group=G_DIV)
bool showParentDivider  = input.bool(true,  "Show Parent Divider",  group=G_DIV)
bool showPrimaryLabels  = input.bool(true,  "Show Primary Labels",  group=G_DIV)

color primaryDividerColor = input.color(color.new(color.gray, 60),   "Primary Divider Color", group=G_DIV)
color parentDividerColor  = input.color(color.new(color.red, 30), "Parent Divider Color",  group=G_DIV)
color primaryLabelColor   = input.color(color.gray, "Primary Label Color", group=G_DIV)
string dividerStyleInput  = input.string("....", "Divider Line Style", options=["____", "----", "...."], group=G_DIV)
dividerStyle = dividerStyleInput == "----" ? line.style_dashed : dividerStyleInput == "____" ? line.style_solid : line.style_dotted

if showPrimaryDivider and primaryNew
    line.new(time, low, time, high, xloc=xloc.bar_time, extend=extend.both, color=primaryDividerColor, style=dividerStyle)

if showParentDivider and parentNew
    line.new(time, low, time, high, xloc=xloc.bar_time, extend=extend.both, color=parentDividerColor, style=dividerStyle, width=1)

if showPrimaryLabels and primaryNew
    label.new(time, low, primaryLabelText, xloc=xloc.bar_time, yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.black, 100), textcolor=primaryLabelColor, size=size.tiny)


// =============================================================================
// 5. DEALING RANGE — fixed calculation windows per your spec (NOT the generic
//    "isFirstSub of primary" rule below ≤15m, since you want Asia specifically
//    on both 5m and 15m charts, not "first 90m of whatever session is active")
// =============================================================================

string G_DR = "Dealing Range"

bool  showDealingRange   = input.bool(true, "Show Dealing Range", group=G_DR)
bool  extendDealingRange = input.bool(true, "Extend Through Parent Period", group=G_DR)
color drColor            = input.color(color.orange, "Dealing Range Color", group=G_DR)

bool drIsFirstSub = false
bool drParentNew  = false

if chartSeconds <= 300                              // 5m and below — 1st 90-minute Q1 of the active session
    drIsFirstSub := subQNum == 1
    drParentNew  := newSession
else if chartSeconds <= 900                         // 15m — Asia session, always
    drIsFirstSub := sessionNum == 1
    drParentNew  := newDay
else if chartSeconds <= 3600                        // 1H — Monday
    drIsFirstSub := tDow == dayofweek.monday
    drParentNew  := newWeek
else if chartSeconds <= 14400                       // 4H — week 1 of month
    drIsFirstSub := weekOfMonth == 1
    drParentNew  := newMonth
else if chartSeconds <= 86400                       // Daily — resets every month (week 1 of that month)
    drIsFirstSub := weekOfMonth == 1
    drParentNew  := newMonth
else                                                  // Weekly+ — no Dealing Range at this tier
    drIsFirstSub := false
    drParentNew  := false

bool drJustLeftFirst = drIsFirstSub[1] and not drIsFirstSub

var float drHigh = na
var float drLow  = na
var int   drStart = na
var line  drHLine = na
var line  drLLine = na

if drParentNew
    drHigh  := na
    drLow   := na
    drStart := na
    drHLine := na
    drLLine := na

if drIsFirstSub
    drHigh  := na(drHigh) ? high : math.max(drHigh, high)
    drLow   := na(drLow)  ? low  : math.min(drLow, low)
    drStart := na(drStart) ? time : drStart

if showDealingRange
    if drJustLeftFirst and not na(drHigh)
        drHLine := line.new(drStart, drHigh, time, drHigh, xloc=xloc.bar_time, extend=extend.none, color=drColor, style=line.style_dashed)
        drLLine := line.new(drStart, drLow,  time, drLow,  xloc=xloc.bar_time, extend=extend.none, color=drColor, style=line.style_dashed)
    else if extendDealingRange and not na(drHLine) and not drIsFirstSub
        line.set_x2(drHLine, time)
        line.set_x2(drLLine, time)

// =============================================================================
// 6. PREMIUM / DISCOUNT — 50% midpoint of the Dealing Range. This is now the
//    single PD calculation, feeding only the Trend Engine (Section 8) — the
//    boundary-based version (close vs. drHigh/drLow) used earlier has been
//    retired: tCISD no longer has its own separate PD gate (see Section 13),
//    it requires the Trend Engine to agree instead, and PD is one of the
//    Trend Engine's three OR'd factors.
// =============================================================================

float pdEquilibrium = na
if not na(drHigh) and not na(drLow)
    pdEquilibrium := (drHigh + drLow) / 2
bool inDiscount = not na(pdEquilibrium) and close < pdEquilibrium
bool inPremium  = not na(pdEquilibrium) and close > pdEquilibrium


// =============================================================================
// 7. TRUE OPENS — "shifted" convention per your spec:
//    Day = unshifted (always 00:00 EST). Week/Month/Quarter/Year = the open
//    of sub-period #2 of that level's own children (Tuesday / week-2 /
//    month-2 / April), matching the True-Open sequence you described.
// =============================================================================

string G_TO = "True Opens"

bool  showTrueOpen  = input.bool(true, "Show Drawn True Open", group=G_TO)
int   historyCycles = input.int(20, "True Open History Kept", minval=1, maxval=200, group=G_TO)
color trueOpenColor = input.color(color.gray, "True Open Color", group=G_TO)

// ---- Always-on trackers (TF-independent, feed Trend Engine + Dashboard) ----
var float dayTrueOpen     = na
var float weekTrueOpen    = na
var float monthTrueOpen   = na
var float quarterTrueOpen = na
var float yearTrueOpen    = na
var float sessionOpen     = na   // literal (unshifted) open of the active session
var float subQ2Open       = na   // session's own TRUE open — shifted to Q2 of its 90-min quarters

// FIX: Day's true open now uses the SAME "2nd child" convention as every
// other level (Tuesday=2nd day of week, week2=2nd week of month, month2=2nd
// month of quarter, April=2nd quarter of year, Q2=2nd 90-min-quarter of
// session). Day's own children are its 4 sessions (Asia/London/NY AM/NY PM),
// so Day's true open = the 2nd session's open = London's start = 00:00 EST —
// NOT `newDay` itself (18:00, Asia's start). The Day DIVIDER (newDay, used
// for MON/TUE/../ labels, week structure, Dealing Range) is untouched and
// stays on 18:00 — dividers and true opens are deliberately different clocks.
if newSession and sessionNum == 2
    dayTrueOpen := open
if newDay and tDow == dayofweek.tuesday
    weekTrueOpen := open
if newWeek and weekOfMonth == 2
    monthTrueOpen := open
if newMonth and monthOfQuarter == 2
    quarterTrueOpen := open
if newQuarter and quarterOfYear == 2
    yearTrueOpen := open
if newSession
    sessionOpen := open
if newSubQ and subQNum == 2
    subQ2Open := open

// ---- Drawn True Open(s) ----
//   Primary   = the PARENT-of-active-bracket's true open (headline marker
//               for this chart tier — same design as before).
//   Secondary = the ACTIVE bracket's own true open, shown alongside the
//               primary only on the three most-intraday tiers (5m-1m, 15m,
//               1H-30M). On 4H+ charts only the single parent marker
//               matters, matching your table — left blank there.
bool   trueOpenTrigger    = false
string trueOpenLabelText  = ""
float  trueOpenPrice      = na

bool   trueOpenTrigger2   = false
string trueOpenLabelText2 = ""
float  trueOpenPrice2     = na

if chartSeconds <= 300                                  // 5m and below — parent = Session (shifted → Q2); own = active session's literal open
    trueOpenTrigger    := newSubQ and subQNum == 2
    trueOpenLabelText  := "Q2 TO"
    trueOpenPrice      := subQ2Open
    trueOpenTrigger2   := newSession
    trueOpenLabelText2 := "Session Open"
    trueOpenPrice2     := sessionOpen
else if chartSeconds <= 900                             // 15m — parent = Day (unshifted, now correctly midnight EST); own = active session's TRUE open (shifted → Q2)
    trueOpenTrigger    := newSession and sessionNum == 2
    trueOpenLabelText  := "TDO"
    trueOpenPrice      := dayTrueOpen
    trueOpenTrigger2   := newSubQ and subQNum == 2
    trueOpenLabelText2 := "Session TO"
    trueOpenPrice2     := subQ2Open
else if chartSeconds <= 3600                            // 1H-30M — parent = Week (shifted → Tuesday); own = active day's true open (unshifted)
    trueOpenTrigger    := newDay and tDow == dayofweek.tuesday
    trueOpenLabelText  := "TWO"
    trueOpenPrice      := weekTrueOpen
    trueOpenTrigger2   := newSession and sessionNum == 2
    trueOpenLabelText2 := "TDO"
    trueOpenPrice2     := dayTrueOpen
else if chartSeconds <= 14400                           // 4H-2H — parent = Month (shifted → week 2). HTF chart: no secondary marker.
    trueOpenTrigger   := newWeek and weekOfMonth == 2
    trueOpenLabelText := "TMO"
    trueOpenPrice     := monthTrueOpen
else if chartSeconds <= 86400                           // Daily — parent = Quarter (shifted → month 2). HTF chart: no secondary marker.
    trueOpenTrigger   := newMonth and monthOfQuarter == 2
    trueOpenLabelText := "TQO"
    trueOpenPrice     := quarterTrueOpen
else                                                      // Weekly+ — parent = Year (shifted → April). HTF chart: no secondary marker.
    trueOpenTrigger   := newQuarter and quarterOfYear == 2
    trueOpenLabelText := "TYO"
    trueOpenPrice     := yearTrueOpen

var line  drawnTOLine   = na
var label drawnTOLabel  = na
var array<line>  toHistLines  = array.new_line()
var array<label> toHistLabels = array.new_label()

var line  drawnTOLine2   = na
var label drawnTOLabel2  = na
var array<line>  toHistLines2  = array.new_line()
var array<label> toHistLabels2 = array.new_label()

if showTrueOpen
    if trueOpenTrigger and not na(trueOpenPrice)
        drawnTOLine  := line.new(time, trueOpenPrice, time, trueOpenPrice, xloc=xloc.bar_time, extend=extend.none, color=trueOpenColor, style=line.style_dotted)
        drawnTOLabel := label.new(time, trueOpenPrice, trueOpenLabelText, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.gray, 100), textcolor=trueOpenColor, size=size.tiny)
        array.push(toHistLines, drawnTOLine)
        array.push(toHistLabels, drawnTOLabel)
        while array.size(toHistLines) > historyCycles
            line.delete(array.shift(toHistLines))
            label.delete(array.shift(toHistLabels))
    else if not na(drawnTOLine)
        line.set_x2(drawnTOLine, time)
        label.set_x(drawnTOLabel, time)

    // Secondary marker (intraday tiers only) — faded so it reads as the
    // lower-priority reference next to the primary headline marker.
    if trueOpenLabelText2 != ""
        if trueOpenTrigger2 and not na(trueOpenPrice2)
            drawnTOLine2  := line.new(time, trueOpenPrice2, time, trueOpenPrice2, xloc=xloc.bar_time, extend=extend.none, color=color.new(trueOpenColor, 45), style=line.style_dotted)
            drawnTOLabel2 := label.new(time, trueOpenPrice2, trueOpenLabelText2, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.gray, 100), textcolor=color.new(trueOpenColor, 45), size=size.tiny)
            array.push(toHistLines2, drawnTOLine2)
            array.push(toHistLabels2, drawnTOLabel2)
            while array.size(toHistLines2) > historyCycles
                line.delete(array.shift(toHistLines2))
                label.delete(array.shift(toHistLabels2))
        else if not na(drawnTOLine2)
            line.set_x2(drawnTOLine2, time)
            label.set_x(drawnTOLabel2, time)


// =============================================================================
// 8. TREND ENGINE — MACD state + 50% Premium/Discount + True Open, OR'd
//    (bullish if ANY of the three agrees — not a majority vote)
// =============================================================================

string G_TREND = "Trend Engine"

bool enableTrendFilter = input.bool(true, "Enable Trend Filter (SSMT/tCISD)", group=G_TREND)

// Internal momentum leg. Not exposed as inputs — only "Enable Trend Filter"
// is user-facing; the momentum calculation itself is an implementation detail.
const int momentumFastLen   = 12
const int momentumSlowLen   = 26
const int momentumSignalLen = 9

[macdLine, macdSignalLine, _] = ta.macd(close, momentumFastLen, momentumSlowLen, momentumSignalLen)

bool macdBull = macdLine > macdSignalLine
bool macdBear = macdLine < macdSignalLine
bool pdBull   = inDiscount
bool pdBear   = inPremium
bool toBull   = not na(trueOpenPrice) and close > trueOpenPrice
bool toBear   = not na(trueOpenPrice) and close < trueOpenPrice

bool bullishTrend = macdBull or pdBull or toBull
bool bearishTrend = macdBear or pdBear or toBear


// =============================================================================
// 9. AUTO SYMBOL MAPPING (unchanged from v2/v3)
// =============================================================================

f_autoSymbols() =>
    string s1 = ""
    string s2 = ""
    string t = str.upper(syminfo.ticker)
    if str.contains(t, "NQ") or str.contains(t, "MNQ")
        s1 := "CME_MINI_DL:ES1!"
        s2 := "CBOT_MINI_DL:YM1!"
    else if str.contains(t, "ES") or str.contains(t, "MES")
        s1 := "CME_MINI_DL:NQ1!"
        s2 := "CBOT_MINI_DL:YM1!"
    else if str.contains(t, "YM") or str.contains(t, "MYM")
        s1 := "CME_MINI_DL:ES1!"
        s2 := "CME_MINI_DL:NQ1!"
    else if str.contains(t, "RTY") or str.contains(t, "M2K") or str.contains(t, "RUT")
        s1 := "CME_MINI_DL:ES1!"
        s2 := "CME_MINI_DL:NQ1!"
    else if str.contains(t, "BTC")
        s1 := "ETHUSDT"
        s2 := "ETHUSD"
    else if str.contains(t, "ETH")
        s1 := "BTCUSDT"
        s2 := "BTCUSD"
    else if str.contains(t, "EURUSD") or str.contains(t, "6E")
        s1 := "GBPUSD"
        s2 := "DXY"
    else if str.contains(t, "GBPUSD") or str.contains(t, "6B")
        s1 := "EURUSD"
        s2 := "DXY"
    else if str.contains(t, "DXY") or str.contains(t, "DX")
        s1 := "EURUSD"
        s2 := "GBPUSD"
    else if str.contains(t, "XAU") or str.contains(t, "GOLD") or str.contains(t, "GC") or str.contains(t, "MGC")
        s1 := "XAGUSD"
        s2 := "DXY"
    else if str.contains(t, "XAG") or str.contains(t, "SILVER") or str.contains(t, "SI") or str.contains(t, "MSI")
        s1 := "XAUUSD"
        s2 := "DXY"
    else
        s1 := "CME_MINI_DL:ES1!"
        s2 := "CBOT_MINI_DL:YM1!"
    [s1, s2]


// =============================================================================
// 10. SSMT — FULL GXV SMT_Divergences[LITE✦] engine (Gregorius_XV), per your
//     explicit request to accept the added complexity: real correlation-
//     library auto pair mapping (Dyad/Triad/Tetrad), all 13 timeframe ranks
//     computed simultaneously, LIVE→CONFIRMED lifecycle, rank-dominance
//     arbitration, aesthetic bypass. This supersedes the single-cycle,
//     chart-timeframe-adaptive version from earlier in this conversation.
//
// ATTRIBUTION: © 2026 Gregorius_XV. Original SMT range reconstruction model,
// deterministic range-key logic, cleanup authority model, Auto Session
// behavior, Aesthetic Bypass system, and the AssetCorrelationUtils pair
// resolver, by Gregorius_XV (TradingView: Gregorius_XV). This Pine Script®
// code is subject to the Mozilla Public License 2.0: https://mozilla.org/MPL/2.0/
// The library import two lines above (GXVSanctuary/AssetCorrelationUtils/5)
// is Pine's native library-import mechanism — the same way GXV's own script
// uses it — not a copy of that library's code.
//
// DELIBERATE EXCEPTION to this build's "one clock" rule: this engine keeps
// GXV's own oracle_tz/session-start-hour clock (`dayStart` etc. below) rather
// than SxM's EST engine, because the rank system's session/quarter/month/
// year bucketing is tightly coupled to that clock in the original design.
// Reimplementing it against SxM's clock would risk silently changing which
// bucket a bar falls into versus the tested original — accepted per your
// "use their GXV logic whole" instruction.
//
// tCISD WIRING (the one deliberate adaptation): GXV's own script only ever
// draws/labels SMT events — it has no external "did anything just confirm"
// signal. `f_smt_run_pair`/`f_run_smt_cycle` below are extended to also
// return whether a bearish/bullish event finalized (LIVE→CONFIRMED) THIS
// bar, for enabled ranks/pairs only, aggregated (OR'd) across all 13 ranks
// into `bearishSSMTEvent`/`bullishSSMTEvent` — the exact same two booleans
// tCISD (Section 13) already arms from. tCISD's arm-trigger line itself is
// untouched.
// =============================================================================

// ---- Legacy sym1/sym2 picker — kept only for Section 11 (HTF SSMT) and the
//      tCISD reference-candle search below, which still use a single plain
//      comparison symbol each. The full GXV engine below has its own,
//      independent multi-pair resolver (smt_corr_pair1/2/3). ----
string G_SSMT = "SSMT Settings (legacy — feeds HTF SSMT + tCISD reference search)"

int    ssmtLength     = input.int(3, "tCISD Reference Search Offset", minval=2, group=G_SSMT, tooltip="How many bars back Section 11 (HTF SSMT) and the tCISD reference-candle search look. Independent of the full GXV SMT engine below.")
bool   autoSmtSymbols = input.bool(true, "Auto Symbols (legacy picker)", group=G_SSMT)
bool   useSym1        = input.bool(true, "Comparison Symbol A", inline="symA", group=G_SSMT)
string manualSym1     = input.symbol("CME_MINI_DL:ES1!", "", inline="symA", group=G_SSMT)
bool   useSym2        = input.bool(true, "Comparison Symbol B", inline="symB", group=G_SSMT)
