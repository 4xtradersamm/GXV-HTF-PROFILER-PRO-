array<int> psp_1d = i_psp_show ? f_calc_psp(o1d_arr, h1d_arr, l1d_arr, c1d_arr, o1d_t2, c1d_t2, o1d_t3, c1d_t3, o1d_t4, c1d_t4) : array.new<int>(5, 0)

o90_0 = array.get(o90_arr, 0), h90_0 = array.get(h90_arr, 0), l90_0 = array.get(l90_arr, 0), c90_0 = array.get(c90_arr, 0), t90_0 = array.get(t90_arr, 0)
o90_1 = array.get(o90_arr, 1), h90_1 = array.get(h90_arr, 1), l90_1 = array.get(l90_arr, 1), c90_1 = array.get(c90_arr, 1), t90_1 = array.get(t90_arr, 1)
o90_2 = array.get(o90_arr, 2), h90_2 = array.get(h90_arr, 2), l90_2 = array.get(l90_arr, 2), c90_2 = array.get(c90_arr, 2), t90_2 = array.get(t90_arr, 2)
o90_3 = array.get(o90_arr, 3), h90_3 = array.get(h90_arr, 3), l90_3 = array.get(l90_arr, 3), c90_3 = array.get(c90_arr, 3), t90_3 = array.get(t90_arr, 3)
o90_4 = array.get(o90_arr, 4), h90_4 = array.get(h90_arr, 4), l90_4 = array.get(l90_arr, 4), c90_4 = array.get(c90_arr, 4), t90_4 = array.get(t90_arr, 4)

o6h_0 = array.get(o6h_arr, 0), h6h_0 = array.get(h6h_arr, 0), l6h_0 = array.get(l6h_arr, 0), c6h_0 = array.get(c6h_arr, 0), t6h_0 = array.get(t6h_arr, 0)
o6h_1 = array.get(o6h_arr, 1), h6h_1 = array.get(h6h_arr, 1), l6h_1 = array.get(l6h_arr, 1), c6h_1 = array.get(c6h_arr, 1), t6h_1 = array.get(t6h_arr, 1)
o6h_2 = array.get(o6h_arr, 2), h6h_2 = array.get(h6h_arr, 2), l6h_2 = array.get(l6h_arr, 2), c6h_2 = array.get(c6h_arr, 2), t6h_2 = array.get(t6h_arr, 2)
o6h_3 = array.get(o6h_arr, 3), h6h_3 = array.get(h6h_arr, 3), l6h_3 = array.get(l6h_arr, 3), c6h_3 = array.get(c6h_arr, 3), t6h_3 = array.get(t6h_arr, 3)
o6h_4 = array.get(o6h_arr, 4), h6h_4 = array.get(h6h_arr, 4), l6h_4 = array.get(l6h_arr, 4), c6h_4 = array.get(c6h_arr, 4), t6h_4 = array.get(t6h_arr, 4)

o1d_0 = array.get(o1d_arr, 0), h1d_0 = array.get(h1d_arr, 0), l1d_0 = array.get(l1d_arr, 0), c1d_0 = array.get(c1d_arr, 0), t1d_0 = array.get(t1d_arr, 0)
o1d_1 = array.get(o1d_arr, 1), h1d_1 = array.get(h1d_arr, 1), l1d_1 = array.get(l1d_arr, 1), c1d_1 = array.get(c1d_arr, 1), t1d_1 = array.get(t1d_arr, 1)
o1d_2 = array.get(o1d_arr, 2), h1d_2 = array.get(h1d_arr, 2), l1d_2 = array.get(l1d_arr, 2), c1d_2 = array.get(c1d_arr, 2), t1d_2 = array.get(t1d_arr, 2)
o1d_3 = array.get(o1d_arr, 3), h1d_3 = array.get(h1d_arr, 3), l1d_3 = array.get(l1d_arr, 3), c1d_3 = array.get(c1d_arr, 3), t1d_3 = array.get(t1d_arr, 3)
